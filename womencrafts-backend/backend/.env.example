# Copy to .env and fill in. NEVER commit .env — it's git-ignored.

# --- Database ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
DB_NAME=womencrafts

# --- Runtime policy ---
# Production also disables demo seeding in code and refuses to start if the
# database or required launch configuration is unavailable.
ENVIRONMENT=development
DEMO_SEED_ENABLED=true

# --- Auth ---
JWT_SECRET_KEY=generate-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Uploads ---
MEDIA_BASE_URL=http://localhost:8010

# --- Email (blank host = writes to backend/outbox/ instead of sending) ---
# Brevo production SMTP defaults. Keep SMTP_PASSWORD only in .env locally and
# in Secret Manager for deployments; never commit the real value.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=no-reply@womsakhi.com
EMAIL_FROM_NAME=WomSakhi

# --- Payments (sandbox needs no account) ---
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=change-me
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- AI: Sakhi's brain (console.anthropic.com) ---
ANTHROPIC_API_KEY=

# --- AI: Sakhi's voice + lip-sync visemes (see docs/azure-speech.md) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
