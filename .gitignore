# Dependencies and build output — regenerable, and enormous.
node_modules/
.next/
out/
build/
dist/
.turbo/

# Python
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets. Never commit these — .env.example is the template that IS committed.
.env
.env.local
.env.*.local
*.pem
*.key

# Private uploads: identity documents live here. They must never leave the host.
private_media/
uploads/

# Editor and OS
.DS_Store
.vscode/
.idea/
*.swp

# Logs and scratch
*.log
# A bare `logs/` matches at ANY depth, and it silently swallowed a whole
# application route: womencrafts-frontend/frontend/src/app/dashboard/settings/
# logs/ — the staff System Logs page — was never committed and existed on one
# machine only. Anchored to the repository root, which is where log output
# actually lands.
/logs/
**/backend/logs/
**/backend/outbox/
.cache/

# Backups
*.bak
*.old

# Local deploy runbook — real project IDs and console paths. Never committed.
DEPLOYMENT.local.md

# Local credential reference. Never committed.
CREDENTIALS.local.env
